<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Portal</title>
  <link rel="stylesheet" href="style1.css" />
</head>
<body>

  <header>
    <h2>Student Portal</h2>
    <nav>
       <form action="/register" method="get" style="display:inline;">
            <!-- <button type="button" id="registerBtn">Register Student</button> -->
                </form>
      <!-- <button id="registerBtn">Register Student</button> -->
      <!-- <button id="showBtn">Show Students</button> -->
        <form action="/show-students" method="get" style="display:inline;">
            <button>Show Students</button>
                </form>
    </nav>
  </header>

  <h1>All Students</h1>

  <div class="students-container">
    <% users.forEach((userData)=> { %>
    <div class="student-card">
      <img src="/uploads/<%= userData._id %>.<%= userData.image.split('.').pop()%>" alt="Ali Raza" />
      <h3><%= userData.name%></h3>
      <p>Course: <%= userData.course %></p>
      <div class="buttons">
        <form action="/edit" method="post">
          <input type="text" name="id" class="hidden" value="<%= userData._id %>">
        <button class="edit-btn">Edit</button>
        </form>

        <form action="/delete" method="post">
          <input type="text" name="id" class="hidden" value="<%= userData._id %>" />
        <button type="submit" class="delete-btn">Delete</button>
        </form>
      </div>
    </div>
    <% }) %>

    <!-- <div class="student-card">
      <img src="https://i.pravatar.cc/150?img=2" alt="Ayesha Khan" />
      <h3>Ayesha Khan</h3>
      <p>Course: Data Science</p>
      <div class="buttons">
        <button class="edit-btn">Edit</button>
        <button class="delete-btn">Delete</button>
      </div>
    </div> -->

